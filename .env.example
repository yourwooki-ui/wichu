EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_ENABLE_REVIEW_SAMPLES=false

# Monetization is fail-closed: the feature flag and matching platform key/ID are both required.
# Test mode uses Google's official test ad units and is rejected by production builds.
EXPO_PUBLIC_MONETIZATION_TEST_MODE=false
EXPO_PUBLIC_MONETIZATION_ENABLED=false
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_sdk_key
EXPO_PUBLIC_REWARDED_ADS_ENABLED=false
EXPO_PUBLIC_INTERSTITIAL_ADS_ENABLED=false
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-0000000000000000~0000000000
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-0000000000000000~0000000000
EXPO_PUBLIC_ADMOB_REWARDED_UNDO_ANDROID_UNIT_ID=ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_ADMOB_REWARDED_UNDO_IOS_UNIT_ID=ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_ADMOB_DISCOVER_INTERSTITIAL_ANDROID_UNIT_ID=ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_ADMOB_DISCOVER_INTERSTITIAL_IOS_UNIT_ID=ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_ADMOB_BROWSE_INTERSTITIAL_ANDROID_UNIT_ID=ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_ADMOB_BROWSE_INTERSTITIAL_IOS_UNIT_ID=ca-app-pub-0000000000000000/0000000000

# Server-only Supabase Edge Function secrets (never prefix with EXPO_PUBLIC_)
# SUPABASE_SECRET_KEY=your-server-secret-key
# DEEPL_API_KEY=your-deepl-api-key
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# REVENUECAT_WEBHOOK_AUTH=replace-with-a-long-random-authorization-value
# ADMOB_REWARDED_UNDO_AD_UNIT_IDS=comma-separated-numeric-callback-ad-unit-ids
